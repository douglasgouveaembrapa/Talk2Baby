# Copie para .env e preencha. Variáveis EXPO_PUBLIC_* são embutidas no app.
#
# Supabase: já vem configurado com valores padrão em src/services/supabase.ts
# (app de uso pessoal). Só defina as variáveis abaixo se quiser apontar para
# outro projeto Supabase.
# EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chaves de IA — OBRIGATÓRIO manter apenas no .env local, NUNCA commitar:
# a OpenAI revoga automaticamente chaves encontradas em repositórios públicos.
EXPO_PUBLIC_AI_PROVIDER=openai
EXPO_PUBLIC_OPENAI_API_KEY=sk-...
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...
